# Copy to .env and fill in. NEVER commit .env.
# Phase 0: only these are required. Each phase adds its own block.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (must match docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Password for the runtime application role (app_rw). NOT a superuser, so that
# Row-Level Security actually applies to it. The owner role above bypasses RLS
# and is used for migrations only.
POSTGRES_APP_PASSWORD=

# Password for the read-only role used later by the SQL tool (Phase 4).
# Created at container init so it exists before anything needs it.
POSTGRES_READONLY_PASSWORD=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=

# --- Embeddings (Phase 1, stage 3) ---
# Get one at https://platform.openai.com/api-keys — it starts with "sk-".
# Used only by the ingestion CLI. Tests use a deterministic fake, and CI never
# calls the API, so no key is needed to run the suite.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Identity ---
# Signing key for locally-issued development tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=https://eaip.local
JWT_AUDIENCE=eaip-api
JWT_TTL_MINUTES=60

# --- Generation ---
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
RAG_TOP_K=5

# Hybrid retrieval measured WORSE than vector-only on the current corpus.
# See docs/experiments/hybrid-search-comparison.md before enabling.
HYBRID_SEARCH_ENABLED=false

# --- Connectors ---
# Encrypts connector credentials at the application layer. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this requires re-encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY=

# --- Console ---
# Origins the browser console is served from. An allowlist, never '*':
# a wildcard would let any site a user visits read their tenant's data
# with the bearer token their browser is holding.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
