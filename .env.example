# Copy to .env and fill in. NEVER commit .env.
# Phase 0: only these are required. Each phase adds its own block.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (must match docker-compose.yml) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Password for the runtime application role (app_rw). NOT a superuser, so that
# Row-Level Security actually applies to it. The owner role above bypasses RLS
# and is used for migrations only.
POSTGRES_APP_PASSWORD=

# Password for the read-only role used later by the SQL tool (Phase 4).
# Created at container init so it exists before anything needs it.
POSTGRES_READONLY_PASSWORD=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=

# --- Embeddings (Phase 1, stage 3) ---
# Get one at https://platform.openai.com/api-keys — it starts with "sk-".
# Used only by the ingestion CLI. Tests use a deterministic fake, and CI never
# calls the API, so no key is needed to run the suite.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Identity ---
# Signing key for locally-issued development tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# This issuer performs NO credential check — it signs whatever it is told, so
# holding this value is holding every identity. It is a development stand-in,
# and it is refused outright when APP_ENV=production and a provider is
# configured below.
JWT_SECRET=
JWT_ISSUER=https://eaip.local
JWT_AUDIENCE=eaip-api
JWT_TTL_MINUTES=60

# --- Identity provider (Phase 11, ADR 0009) ---
# Set OIDC_JWKS_URL to switch verification to RS256 against the provider's
# PUBLIC keys. Once set, this process can verify an identity but can no longer
# mint one — which is the entire point, since the symmetric key above can do
# both.
#
# Leave both empty for local development. For the Keycloak realm in
# docker-compose, they are:
#   OIDC_JWKS_URL=http://localhost:8081/realms/eaip/protocol/openid-connect/certs
#   OIDC_ISSUER=http://localhost:8081/realms/eaip
#
# OIDC_ISSUER has no fallback to JWT_ISSUER on purpose: an issuer check that
# silently used the local value would accept a locally-minted token on the
# provider's verification path.
OIDC_JWKS_URL=
OIDC_ISSUER=

# Where identity lives in the provider's tokens. These defaults match the realm
# import in infra/keycloak/. Change them to match a different provider rather
# than changing the application.
OIDC_TENANT_CLAIM=https://eaip.dev/tenant_id
OIDC_EMAIL_CLAIM=email
OIDC_ROLES_CLAIM=realm_access
OIDC_LABELS_CLAIM=https://eaip.dev/labels

# --- Generation ---
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
RAG_TOP_K=5

# Hybrid retrieval measured WORSE than vector-only on the current corpus.
# See docs/experiments/hybrid-search-comparison.md before enabling.
HYBRID_SEARCH_ENABLED=false

# --- Connectors ---
# Encrypts connector credentials at the application layer. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this requires re-encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY=

# --- Console ---
# Origins the browser console is served from. An allowlist, never '*':
# a wildcard would let any site a user visits read their tenant's data
# with the bearer token their browser is holding.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Development only. The analytics database runs on localhost here, and egress
# control blocks loopback by design — a connector reaching the platform's own
# Postgres would bypass the Row-Level Security everything else depends on.
ALLOW_LOOPBACK_CONNECTORS=false

# MySQL, for proving the SQL safety layers against the engine the target
# systems actually run. 3307 because 3306 is commonly taken.
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=local-mysql-root-password

# --- Production (docker-compose.prod.yml only — unused in local development) ---
# Consumed by Docker Compose itself, not by the application, so these have no
# equivalent above: docker-compose.yml's dev Keycloak hardcodes admin/admin
# and needs no domain because start-dev guesses one from request headers.
#
# The exact public hostname Keycloak will be told to issue tokens and
# redirect URLs for, no scheme, no path — e.g. aiplatform.clbgroups.com.
# Read by docker-compose.prod.yml as KC_HOSTNAME=https://${EAIP_DOMAIN}. Get
# this wrong and Keycloak issues URLs for the wrong origin: logins work from
# the server itself and break for every real visitor.
EAIP_DOMAIN=

# No defaults for these three, unlike the dev compose file's admin/admin — a
# production deployment that forgot to set a real password should fail to
# start, not start with a credential this repository already publishes.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
