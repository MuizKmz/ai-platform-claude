# Copy to .env.local. NEVER commit .env.local.
# The FastAPI backend this console talks to.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Identity provider (Phase 11, ADR 0009) ---
# Set the issuer to send people to a real sign-in page instead of asking them to
# paste a token. Leave it empty and the paste-a-token form stays, which is the
# development path.
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is readable by anyone
# using the console. That is correct here: an issuer URL and a public client id
# are not secrets. There is deliberately NO client secret — a browser
# application cannot keep one, so the flow uses PKCE instead.
#
# For the Keycloak realm in docker-compose:
#   NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/eaip
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=eaip-console
